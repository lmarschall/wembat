{
    "compilerOptions": {
      "target": "esnext",
      "useDefineForClassFields": true,
      "outDir": "./dist",
      "module": "esnext",
      "moduleResolution": "node",
      "strict": true,
      "jsx": "preserve",
      "sourceMap": true,
      "resolveJsonModule": true,
      "isolatedModules": true,
      "esModuleInterop": true,
      "lib": ["esnext", "dom"],
      "skipLibCheck": true
    },
    "include": ["src/**/*.d.ts", "src/**/*.ts"],
    "references": [{ "path": "./tsconfig.node.json" }]
  }